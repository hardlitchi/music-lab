{
  "name": "music-lab",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,server -c cyan,yellow \"npm -w packages/frontend run dev\" \"npm -w packages/server run dev\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck -w packages/frontend",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
