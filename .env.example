# =============================================================
#  楽曲工房 — 環境変数テンプレート
#  .env にコピーして使用: cp .env.example .env
# =============================================================

# ----- ポート設定 -----
FRONTEND_PORT=5200
SERVER_PORT=4001
ACESTEP_PORT=8000

# ----- フロントエンド -----
VITE_API_BASE_URL=http://localhost:4001

# ----- サーバー設定 -----
NODE_ENV=development
CORS_ORIGIN=http://localhost:5200

# ----- ACE-Step 設定 -----
ACESTEP_API_URL=http://localhost:8000
AUDIO_OUTPUT_DIR=./output

# ----- ACE-Step チューニング -----
ACESTEP_BF16=true
ACESTEP_TORCH_COMPILE=false
ACESTEP_CPU_OFFLOAD=false       # VRAM < 8GB の場合は true
ACESTEP_OVERLAPPED_DECODE=false
