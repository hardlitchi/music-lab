# =============================================================
#  楽曲工房 — 環境変数テンプレート
#  .env にコピーして使用してください: cp .env.example .env
# =============================================================

# ----- ポート設定 -----
FRONTEND_PORT=5200
SERVER_PORT=4001

# ----- フロントエンド -----
VITE_API_BASE_URL=http://localhost:4001

# ----- サーバー設定 -----
NODE_ENV=development
CORS_ORIGIN=http://localhost:5200

# ----- ACE-Step ローカルサーバー -----
# pip install acestep && python -c "from acestep import infer_api; infer_api.run()" 等で起動
# デフォルトポートは 8000 (infer-api.py)
ACESTEP_API_URL=http://localhost:8000

# ----- 生成ファイルの保存先 -----
# ACE-Step と本サーバーの両方からアクセス可能な絶対パスを指定
AUDIO_OUTPUT_DIR=./output
